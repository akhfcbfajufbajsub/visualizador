# Template genérico — SKELETON
# Contrato: init(vals), step() -> {"a": int, "b": int, "swap": bool, "done": bool}

items = []
n = 0
i = 0
j = 0
fase = "buscar"

def init(vals):
    global items, n, i, j, fase
    items = list(vals)
    n = len(items)
    i = 1
    j = i
    fase = "buscar"

def step():
    global items, n, i, j, fase
    if i >= n:
        return {"a": -1, "b": -1, "swap": False, "done": True}
    
    if fase == "buscar":
        if j < n and items[j] < items[j-1]:
            fase = "insertar"
            return step()
        else:
            i += 1
            j = i
            return {"a": j-1, "b": j, "swap": False, "done": False}
    
    if fase == "insertar":
        if j > 0 and items[j] < items[j-1]:
            items[j], items[j-1] = items[j-1], items[j]
            result = {"a": j, "b": j-1, "swap": True, "done": False}
            j -= 1
            return result
        else:
            i += 1
            j = i
            fase = "buscar"
            return {"a": j-1, "b": j, "swap": False, "done": False}
